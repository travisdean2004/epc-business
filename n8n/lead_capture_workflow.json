{
  "name": "EPC Lead Capture Pipeline",
  "nodes": [
    {
      "name": "Facebook Lead Form",
      "type": "webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "path": "epc-lead-webhook",
        "method": "POST"
      }
    },
    {
      "name": "Parse Lead Data",
      "type": "set",
      "position": [
        450,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "key": "name",
              "value": "={{ $json.first_name }} {{ $json.last_name }}"
            },
            {
              "key": "phone",
              "value": "={{ $json.phone_number }}"
            },
            {
              "key": "email",
              "value": "={{ $json.email }}"
            },
            {
              "key": "source",
              "value": "facebook"
            },
            {
              "key": "created_at",
              "value": "={{ new Date().toISOString() }}"
            }
          ]
        }
      }
    },
    {
      "name": "Supabase Insert",
      "type": "supabase",
      "position": [
        650,
        300
      ],
      "parameters": {
        "method": "insert",
        "table": "leads",
        "data": "={{ $json }}"
      }
    },
    {
      "name": "Send Telegram",
      "type": "telegram",
      "position": [
        850,
        300
      ],
      "parameters": {
        "chatId": "-5476036884",
        "text": "\ud83d\udd25 NEW LEAD\\n{{ $json.name }}\\n\ud83d\udcde {{ $json.phone }}\\n\ud83d\udce7 {{ $json.email }}"
      }
    },
    {
      "name": "Log to Hermes",
      "type": "http",
      "position": [
        1050,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/leads/log",
        "body": "={{ $json }}"
      }
    }
  ],
  "connections": {
    "Facebook Lead Form": [
      {
        "node": "Parse Lead Data",
        "type": "main"
      }
    ],
    "Parse Lead Data": [
      {
        "node": "Supabase Insert",
        "type": "main"
      }
    ],
    "Supabase Insert": [
      {
        "node": "Send Telegram",
        "type": "main"
      }
    ],
    "Send Telegram": [
      {
        "node": "Log to Hermes",
        "type": "main"
      }
    ]
  }
}